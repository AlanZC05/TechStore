# ============================================================================
# TechStore MX - Monorepo Environment Configuration (.env.example)
# ============================================================================

# Shared JWT Configuration (HS256)
JWT_SECRET=techstore_mx_super_secret_hs256_signing_key_2026_e3_e4
JWT_ISSUER=techstore-auth-service
JWT_AUDIENCE=techstore-main-backend,techstore-fx-microservice
JWT_EXPIRES_IN_SECONDS=900

# Service Ports
AUTH_SERVICE_PORT=4001
FX_SERVICE_PORT=4002
MAIN_BACKEND_PORT=4000
FRONTEND_PORT=5173

# Cross-Service URLs & CORS
CORS_ORIGIN=http://localhost:5173
FX_SERVICE_URL=http://localhost:4002
AUTH_SERVICE_URL=http://localhost:4001
MAIN_BACKEND_URL=http://localhost:4000

# Banxico SIE API Configuration (Series SF43718 - USD/MXN FIX)
# Replace with a real Banxico token or leave as demo_token_or_real_token for automatic fallback evaluation
BANXICO_API_TOKEN=demo_token_or_real_token
BANXICO_SERIES_ID=SF43718
BANXICO_TIMEOUT_MS=4000
FALLBACK_USD_MXN_RATE=19.854

# Password Hashing Cost (bcrypt rounds)
BCRYPT_SALT_ROUNDS=12

