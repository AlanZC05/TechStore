{
  "name": "techstore-mx-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TechStore MX - Multi-Currency Hardware Store & Catalog Platform (Evidence 3 & Evidence 4 Monorepo)",
  "workspaces": [
    "services/auth-service",
    "services/fx-microservice",
    "services/main-backend",
    "frontend"
  ],
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "prestart": "node scripts/setup-env.js",
    "start": "concurrently -n AUTH,FX,BACKEND,FRONTEND -c cyan,magenta,green,yellow \"npm run start --workspace=services/auth-service\" \"npm run start --workspace=services/fx-microservice\" \"npm run start --workspace=services/main-backend\" \"npm run dev --workspace=frontend\"",
    "dev": "npm start",
    "start:auth": "npm run start --workspace=services/auth-service",
    "start:fx": "npm run start --workspace=services/fx-microservice",
    "start:backend": "npm run start --workspace=services/main-backend",
    "start:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "testTimeout": 30000
  }
}

